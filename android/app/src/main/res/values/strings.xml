    <!-- betterendfield.ui -->
    <string name="ui_card_eyebrow">INTERFACE · betterendfield.ui</string>
    <string name="ui_card_title">界面增强</string>
    <string name="ui_card_subtitle">与桌面端同源编译。隐藏 UID 是常驻开关；隐藏全部 HUD 需要在游戏里即时切换，开关在这里，触发按钮在悬浮窗。</string>
    <string name="ui_hide_uid">隐藏 UID 水印</string>
    <string name="ui_hide_uid_hint">隐藏游戏画面中的账号 UID 水印，并每 2 秒补扫一次已存在的面板。</string>
    <string name="ui_hide_hud">启用隐藏全部 HUD</string>
    <string name="ui_hide_hud_hint">隐藏或恢复游戏内 MainHudRoot 下的全部 HUD 画布，不影响菜单和设置界面。由悬浮窗的按钮切换。</string>

    <!-- betterendfield.camera -->
    <string name="camera_card_eyebrow">CAMERA · betterendfield.camera</string>
    <string name="camera_card_title">相机增强</string>
    <string name="camera_card_subtitle">自由视角、世界暂停和第一人称都要在游戏里即时触发，按钮在悬浮窗；这里只决定哪些功能装载、以及它们的参数。</string>
    <string name="camera_dither">移除角色近距离虚化</string>
    <string name="camera_dither_hint">调用游戏自身的 ForceClearDither，移除镜头贴近角色时的半透明虚化。无需热键。</string>
    <string name="camera_free">启用自由视角功能</string>
    <string name="camera_free_hint">进入时捕获主相机的位置和视野，退出后恢复原值。悬浮窗展开后会出现方向键与升降键。</string>
    <string name="camera_pause">启用时间冻结功能</string>
    <string name="camera_pause_hint">冻结游戏时间但保留镜头移动。桌面端同样把它挂在自由视角下，因此需要先启用自由视角。</string>
    <string name="camera_fp_eye_forward">眼位前移（游戏单位）</string>
    <string name="camera_fp_movement">身体跟随观察方向</string>
    <string name="camera_fp_movement_hint">启用后按观察方向调整身体朝向；尚待实机验证。</string>
    <string name="camera_fp_side_look_limit">侧视转身阈值</string>
    <string name="camera_fp_animation_mode">动画朝向跟随模式</string>
    <string name="camera_fp_animation_off">关闭</string>
    <string name="camera_fp_animation_body">身体</string>
    <string name="camera_fp_animation_head">头部</string>
    <string name="camera_fp_animation_realistic">真实（含头部翻滚）</string>
    <string name="camera_fp_animation_strength">动画朝向跟随强度</string>
    <string name="camera_fp_yield_dialogue">对话时让出相机控制</string>
    <string name="camera_fp_yield_dialogue_hint">对话期间交还游戏相机，结束后恢复第一人称；尚待实机验证。</string>
    <string name="camera_fp_third_person_in_combat">战斗时切换第三人称</string>
    <string name="camera_fp_third_person_in_combat_hint">进入战斗时交还游戏相机，战斗结束后恢复第一人称；默认关闭，尚待实机验证。</string>
    <string name="camera_fp_transition_seconds">视角切换过渡时间（0 为关闭）</string>
    <string name="camera_fp_seconds">秒</string>
    <string name="camera_fp_external_head_scale">外部模型缩头兼容</string>
    <string name="camera_fp_external_head_scale_hint">仅在你使用外部改模且需要缩头时手动开启；会影响头部阴影。尚待实机验证。</string>
    <string name="camera_fp_eye_height">眼位高度（游戏单位）</string>
    <string name="camera_fp_near_clip">近裁剪面（游戏单位）</string>
    <string name="camera_fp_extend_look_range">放宽俯仰范围</string>
    <string name="camera_fp_extend_look_range_hint">扩大第一人称上下观察范围；默认关闭。保存后立即生效。</string>
    <string name="camera_first_person">启用第一人称视角功能</string>
    <string name="camera_first_person_hint">将视点固定到当前操控角色的头部。与自由视角相互独立，可单独启用。</string>
    <string name="camera_hide_head">隐藏头部（第一人称）</string>
    <string name="camera_hide_head_hint">使用独立网格副本隐藏头部，保留身体、手臂和原始阴影。</string>
    <string name="camera_fill_neck">填补颈部开口</string>
    <string name="camera_fill_neck_hint">隐藏头部后会露出颈部开口，用一小块补面遮住。</string>
    <string name="camera_speed_label">移动速度</string>
    <string name="camera_fp_fov_label">第一人称视野（FOV）</string>

    <!-- betterendfield.camera · 运镜与镜头 -->
    <string name="camera_motion_hint_short">预设运镜、关键帧段长与 VMD 镜头参数</string>
    <string name="camera_motion_subtitle">自由镜头的进阶参数。触发按钮在悬浮窗的「运镜 / 关键帧」区，这里只决定参数。这一页（含第一人称与自由视角）的改动会直接投递给正在运行的游戏，无需重启——只有首次启用相机功能时需要重启一次，因为那时模块还没被载入游戏进程。</string>
    <string name="motion_group_look">转向（拖动）</string>
    <string name="motion_look_sensitivity_label">转向灵敏度</string>
    <string name="motion_look_sensitivity_unit">°/像素</string>
    <string name="motion_look_hint">游戏内面板的「拖动转向」按它换算：数值越大，同样的拖动转得越多。默认 0.1 时滑过整个拖动区约转四分之一圈（随屏幕密度略有出入）。</string>
    <string name="motion_look_invert">Y 轴反转</string>
    <string name="motion_look_invert_hint">上滑改为俯视、下滑改为仰视。</string>
    <string name="motion_group_preset">运镜预设</string>
    <string name="motion_preset_label">预设</string>
    <string name="motion_preset_orbit">环绕</string>
    <string name="motion_preset_dolly_zoom">希区柯克变焦</string>
    <string name="motion_preset_crane">升降</string>
    <string name="motion_preset_truck">横移</string>
    <string name="motion_preset_hint">环绕：绕锚点转圈。希区柯克变焦：推近的同时反向拉大视野。升降、横移：匀速直线运动。锚点取当前操控角色，取不到时退到镜头前方 5 米；时长到点后自动结束。</string>
    <string name="motion_speed_label">运镜速度倍率</string>
    <string name="motion_speed_unit">×</string>
    <string name="motion_orbit_speed_label">环绕角速度</string>
    <string name="motion_orbit_speed_unit">°/s</string>
    <string name="motion_duration_label">运镜时长（0 为无限）</string>
    <string name="motion_target_height_label">锚点高度（游戏单位）</string>
    <string name="motion_group_keyframe">关键帧</string>
    <string name="motion_keyframe_segment_label">关键帧段长（秒）</string>
    <string name="motion_keyframe_loop">循环回放关键帧</string>
    <string name="motion_keyframe_loop_hint">播完最后一段后从头继续。</string>
    <string name="motion_keyframe_note">关键帧在游戏内由悬浮窗记录，最多 64 个；位置走 Catmull-Rom、朝向走球面插值、视野线性插值。段长决定相邻关键帧之间过渡多久。</string>
    <string name="motion_group_vmd">VMD 镜头</string>
    <string name="motion_vmd_scale_label">位移缩放</string>
    <string name="motion_vmd_fov_bias_label">视野偏置</string>
    <string name="motion_vmd_loop">循环播放 VMD</string>
    <string name="motion_vmd_loop_hint">播完最后一帧后从头继续。</string>
    <string name="motion_vmd_note">作用于导入的 .vmd 镜头文件（MMD 相机轨道）。导入的文件会在游戏运行中被同步到游戏自己的目录，配置也随之即时生效，无需重启。标定值（位移缩放 0.07、视野偏置 +5°）来自 MMD 场景，本作里可能需要按实际画面微调。按下悬浮窗的 VMD 按钮会自动进入自由视角。</string>
    <string name="motion_vmd_import">导入 VMD 镜头文件</string>
    <string name="motion_vmd_clear">清除导入</string>
    <string name="motion_vmd_not_imported">还没有导入 .vmd 镜头文件，按下 VMD 按钮只会在面板日志里提示未配置文件。</string>
