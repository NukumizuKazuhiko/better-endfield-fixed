    <!-- betterendfield.actions -->
    <string name="dash_card_eyebrow">SPRINT · betterendfield.actions</string>
    <string name="dash_card_title">冲刺持续</string>
    <string name="dash_card_subtitle">分角色开启特殊冲刺动作的持续播放。循环段由随包附带的骨骼姿态数据接管，桌面端不用热键，因此这一页就是全部设置。</string>
    <string name="dash_enable">启用冲刺持续</string>
    <string name="dash_enable_hint">保留游戏本次选中的左或右特殊冲刺动作，在持续冲刺时循环播放，延后自然结束；停止或被打断时结束。</string>
    <string name="dash_group_characters">适用角色</string>
    <string name="dash_aglina">洁尔佩塔</string>
    <string name="dash_aglina_hint">续接 sprint_dash_sp 特效并重新点燃 3 秒的高光。</string>
    <string name="dash_liino">梨诺</string>
    <string name="dash_liino_hint">保留脚下滑板与武器尾焰，推迟游戏在 2.2 秒收板的动作。</string>
    <string name="dash_group_options">可选项</string>
    <string name="dash_pose_note">循环段使用随模块附带的骨骼姿态数据，动画由 %1$s 接管；原生动作与移动逻辑保持不变。</string>
    <string name="dash_liino_clean">隐藏机甲与光效</string>
    <string name="dash_liino_clean_hint">梨诺冲刺全程隐藏机甲（含腿甲）与光效，保留飞行动画。</string>

