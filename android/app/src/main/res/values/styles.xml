<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The window theme only. It exists so the window is drawn on the app's own
      background from the very first frame, before Compose has composed anything;
      everything inside it is themed by BetterEndfieldTheme in UiTheme.kt, which is
      where the switch, slider and dropdown colours are overridden.
    -->
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:navigationBarColor">@color/app_background</item>
        <item name="android:statusBarColor">@color/app_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>
